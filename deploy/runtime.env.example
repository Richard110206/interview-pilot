# =====================================================================
# Yingda runtime environment template
# Copy to a location of your choice (the dev scripts read .local/runtime.env
# at the repository parent) and fill in real values. NEVER commit real keys.
#   cp deploy/runtime.env.example ../.local/runtime.env
# =====================================================================

# ---------- Infrastructure (must match deploy/compose.local.yml) ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=yingda
MYSQL_USERNAME=root
MYSQL_PASSWORD=REPLACE_WITH_YOUR_LOCAL_PASSWORD
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27018
MONGODB_DATABASE=yingda
SERVER_PORT=8002

# ---------- Chat / interview model (required) ----------
# Any OpenAI-compatible endpoint works. DeepSeek is used by default.
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
SPRING_AI_OPENAI_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_KEY
SPRING_AI_OPENAI_MODEL=deepseek-flash
SPRING_AI_OPENAI_EMBEDDING_ENABLED=false

# ---------- Interview mode ----------
# deepseek = direct Java -> model calls (default, no cloud workflow needed)
# xingchen = upstream cloud workflow mode (needs Xunfei/Xingchen credentials)
XUNZHI_INTERVIEW_AI_PROVIDER=deepseek
XUNZHI_INTERVIEW_QUESTION_COUNT=3
XUNZHI_AGENT_SECURITY_REQUIRE_XUNFEI_SECRETS=false

# ---------- Xunfei / Xingchen cloud workflow (optional) ----------
# Only needed for upstream cloud mode (voice / expression analysis).
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_RTA_API_KEY=

# ---------- RAG: question bank + knowledge base (optional but recommended) ----------
# Question-bank RAG uses Redis Stack vector search; knowledge-doc RAG chunks
# uploaded PDFs into a separate vector index. Both degrade gracefully when off.
XUNZHI_QUESTION_BANK_RAG_ENABLED=true
XUNZHI_KNOWLEDGE_RAG_ENABLED=true

# ---------- Embedding model (required when RAG is enabled) ----------
# DashScope (Alibaba Cloud Bailian) Qwen text-embedding-v3, 1024 dims.
DASHSCOPE_API_KEY=REPLACE_WITH_YOUR_DASHSCOPE_KEY
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ---------- Web search for question-bank expansion (optional) ----------
# Primary: DeepSeek built-in search API (reuses the DeepSeek key above).
DEEPSEEK_SEARCH_ENABLED=true
# Fallback: Tavily (https://tavily.com, free dev tier available).
TAVILY_API_KEY=
